# Anthropic
ANTHROPIC_API_KEY=

# Google Sheets (service account with edit access to the sheet).
# Optional: defaults to ./service-account.json next to the code. Set this only
# to point somewhere else, and prefer an absolute path if you do.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
GOOGLE_SHEET_ID=
SIGNALS_SHEET_NAME=Sheet3
REPORTS_SHEET_NAME=WeeklyReports

# Gmail (App Password — https://myaccount.google.com/apppasswords, requires 2FA enabled)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=
